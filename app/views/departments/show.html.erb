<div class="container mt-4" style="max-width: 700px;">
  <h1 class="mb-4"><%= @department.name %></h1>

  <%= form_with model: [@department, Product.new], class: "mb-4" do |f| %>
    <div class="input-group">
      <%= f.text_field :code, placeholder: "品番", class: "form-control" %>
      <%= f.text_field :name, placeholder: "製品名", required: true, class: "form-control" %>
      <%= f.submit "製品を登録", class: "btn btn-success" %>
    </div>
  <% end %>

  <table class="table table-hover">
    <thead>
      <tr>
        <th>品番</th>
        <th>製品名</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td><%= product.code %></td>
          <td><%= link_to product.name, product, class: "text-decoration-none" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= link_to "部署一覧に戻る", departments_path, class: "btn btn-outline-secondary" %>
</div>