<div class="container mt-5" style="max-width: 700px;">
  <h1 class="text-center mb-4">ユーザー一覧</h1>

  <% if flash[:notice] %>
    <div class="alert alert-success py-2"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="alert alert-danger py-2"><%= flash[:alert] %></div>
  <% end %>

  <table class="table table-hover">
    <thead>
      <tr>
        <th>社員番号</th>
        <th>登録日</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.employee_number %></td>
          <td><%= user.created_at.strftime("%Y/%m/%d") %></td>
          <td class="text-end"><%= link_to "詳細", user, class: "btn btn-sm btn-outline-secondary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>