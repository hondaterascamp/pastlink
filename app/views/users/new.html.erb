<div class="container mt-5" style="max-width: 500px;">
  <h1 class="text-center mb-4">Sign up</h1>

  <% @user.errors.full_messages.each do |msg| %>
    <div class="alert alert-danger py-2"><%= msg %></div>
  <% end %>

  <%= form_with model: @user do |f| %>
    <div class="mb-3">
      <%= f.text_field :employee_number, required: true, autofocus: true, placeholder: "社員番号", class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.password_field :password, required: true, autocomplete: "new-password", placeholder: "パスワード", maxlength: 72, class: "form-control" %>
    </div>

    <div class="mb-4">
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "パスワード（確認）", maxlength: 72, class: "form-control" %>
    </div>

    <%= f.submit "Sign up", class: "btn btn-success w-100" %>
  <% end %>

  <div class="text-center mt-3">
    アカウントをお持ちの方は
    <%= link_to "Log in", new_session_path %>
  </div>
</div>