<div class="container mt-4" style="max-width: 800px;">
  <p class="text-muted mb-1"><%= link_to @product.department.name, @product.department, class: "text-decoration-none" %></p>
  <h1 class="mb-4"><%= @product.name %> <small class="text-muted fs-5"><%= @product.code %></small></h1>

  <%# ── トラブル登録 ── %>
  <div class="card mb-5">
    <div class="card-header"><i class="fa-solid fa-triangle-exclamation"></i> トラブル登録</div>
    <div class="card-body">
      <%= form_with model: [@product, Trouble.new] do |f| %>
        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :machine_name, "機械名", class: "form-label" %>
            <%= f.text_field :machine_name, list: "machine-list", required: true, class: "form-control", placeholder: "例：射出成形機1号" %>
            <datalist id="machine-list">
              <% @machines.each do |machine| %>
                <option value="<%= machine.name %>"></option>
              <% end %>
            </datalist>
          </div>
          <div class="col-md-6">
            <%= f.label :status, "対応ステータス", class: "form-label" %>
            <%= f.select :status, Trouble.statuses.keys, {}, { class: "form-select" } %>
          </div>
          <div class="col-md-6">
            <%= f.label :stopped_at, "停止日時", class: "form-label" %>
            <%= f.datetime_local_field :stopped_at, class: "form-control", required: true %>
          </div>
          <div class="col-md-6">
            <%= f.label :downtime, "停止時間（分）", class: "form-label" %>
            <%= f.number_field :downtime, min: 0, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= f.label :content, "トラブル内容", class: "form-label" %>
            <%= f.text_area :content, rows: 3, class: "form-control", required: true %>
          </div>
          <div class="col-12">
            <%= f.label :cause, "原因", class: "form-label" %>
            <%= f.text_area :cause, rows: 2, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= f.label :action, "対応内容", class: "form-label" %>
            <%= f.text_area :action, rows: 2, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= f.label :photo, "写真", class: "form-label" %>
            <%= f.file_field :photo, accept: "image/*", class: "form-control" %>
          </div>
          <div class="col-12">
            <%= f.submit "トラブルを登録", class: "btn btn-success w-100" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── トラブル記録一覧 ── %>
  <h5 class="mb-3"><i class="fa-solid fa-clock-rotate-left"></i> トラブル記録</h5>

  <% if @troubles.empty? %>
    <p class="text-muted">まだトラブル記録はありません。</p>
  <% end %>

  <% @troubles.each do |trouble| %>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between">
        <span><%= trouble.stopped_at.strftime("%Y/%m/%d %H:%M") %> <%= trouble.machine.name %></span>
        <span class="badge <%= { "未対応" => "text-bg-danger", "対応中" => "text-bg-warning", "完了" => "text-bg-success" }[trouble.status] %>">
          <%= trouble.status %>
        </span>
      </div>
      <div class="card-body">
        <table class="table table-sm mb-3">
          <tr><th style="width: 120px;">トラブル内容</th><td><%= simple_format(trouble.content) %></td></tr>
          <tr><th>停止時間</th><td><%= trouble.downtime ? "#{trouble.downtime} 分" : "―" %></td></tr>
          <tr><th>原因</th><td><%= trouble.cause.present? ? simple_format(trouble.cause) : "―" %></td></tr>
          <tr><th>対応内容</th><td><%= trouble.action.present? ? simple_format(trouble.action) : "―" %></td></tr>
          <tr><th>記録者</th><td><%= trouble.user.name.presence || trouble.user.employee_number %></td></tr>
        </table>
        <% if trouble.photo.attached? %>
          <%= image_tag trouble.photo, class: "img-fluid rounded", style: "max-height: 300px;" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= link_to "#{@product.department.name}に戻る", @product.department, class: "btn btn-outline-secondary" %>
</div>